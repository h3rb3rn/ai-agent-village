# Copy this file to .env, replace the endpoint addresses and run:
#   sudo ./bootstrap-ai-village.sh --env ./.env
#
# This is sourced by Bash as root. Keep it trusted and mode 0600.

VILLAGE_ROOT=/var/lib/ai-village
# A deliberate cadence: model generation, tool work and reflection are slow.
VILLAGE_CYCLE_SECONDS=90
# Long work is normal: one hour for tools/builds, 30 minutes for a model reply.
# Set the command value to 0 only when an explicitly unbounded command is intended.
VILLAGE_COMMAND_TIMEOUT_SECONDS=3600
VILLAGE_OLLAMA_TIMEOUT_SECONDS=1800
# A failed or overloaded inference lane is retried slowly, so it does not create
# an error storm or compete with healthy residents.
VILLAGE_OFFLINE_RETRY_SECONDS=120
VILLAGE_MAX_OUTPUT_BYTES=16384
VILLAGE_BOARD_TAIL_LINES=16

# true asks each declared Ollama server to pull the model via POST /api/pull.
# Set false when the model is already loaded on that endpoint.
VILLAGE_PULL_MODELS=true
VILLAGE_PULL_TIMEOUT_SECONDS=7200
# Context default in tokens. It applies only where an agent has no individual
# OLLAMA_AGENT_<n>_NUM_CTX setting below.
VILLAGE_DEFAULT_NUM_CTX=8192
# Allow deliberate planning. At roughly 20 token/s, 768 tokens are about 38s
# of generation before prompt evaluation and tool work.
VILLAGE_DEFAULT_NUM_PREDICT=768
# Ollama thinking-capable models may use low, medium, high or max internally;
# only the final structured decision is persisted on the Board.
VILLAGE_DEFAULT_THINK_LEVEL=medium
VILLAGE_DEFAULT_KEEP_ALIVE=10m
# A short, truthful description of the current physical habitat is placed in
# every resident's identity prompt. Keep this current when the Village moves.
VILLAGE_RESOURCE_PROFILE="temporary resource-bounded habitat; inspect the live snapshot before acting"
# Residents must not begin material work below this host-wide MemAvailable floor.
VILLAGE_MIN_FREE_MEMORY_MIB=4096

# village-update is always installed. These flags enable its weekly timer and
# a reboot after updates only when Debian signals that a reboot is required.
VILLAGE_AUTO_UPDATE=false
VILLAGE_AUTO_REBOOT=false

# Public contact surface. The service itself is plain HTTP; expose it through
# a TLS reverse proxy on the Pi, then forward only the proxy to this port.
VILLAGE_WEBUI_ENABLED=true
VILLAGE_WEBUI_BIND=0.0.0.0
VILLAGE_WEBUI_PORT=8080
VILLAGE_WEBUI_MAX_MESSAGE_CHARS=4000
# Passive telemetry polling interval. It never writes to the Board or prompts.
VILLAGE_TELEMETRY_INTERVAL_SECONDS=15

# Human knowledge library. Allow ${language}.wikipedia.org through the Pi/Squid.
# Replace the placeholder with a real operator contact as required by Wikimedia.
VILLAGE_WIKIPEDIA_ENABLED=true
VILLAGE_WIKIPEDIA_LANGUAGE=de
VILLAGE_WIKIPEDIA_TIMEOUT_SECONDS=60
VILLAGE_WIKIPEDIA_USER_AGENT="AI-Village/0.1 (https://signals.example/; operator@example.invalid)"

# Each numbered block creates one Unix user and one resident service.
# NAME becomes village-<name>; it must be unique, lowercase and use [a-z0-9-].
OLLAMA_AGENT_1_NAME=king
OLLAMA_AGENT_1_URL=http://10.10.10.35:11434
OLLAMA_AGENT_1_MODEL=qwen3.6:35b
OLLAMA_AGENT_1_ROLE=king
OLLAMA_AGENT_1_NUM_CTX=132096
OLLAMA_AGENT_1_NUM_PREDICT=2048
OLLAMA_AGENT_1_THINK_LEVEL=high
OLLAMA_AGENT_1_KEEP_ALIVE=30m
OLLAMA_AGENT_1_TEMPERAMENT="langfristig, synthetisch und konfliktvermittelnd"
OLLAMA_AGENT_1_FOCUS="evidence-based coordination, conflict mediation, and protection of cognitive diversity"

OLLAMA_AGENT_2_NAME=scout-1
OLLAMA_AGENT_2_URL=http://10.10.10.41:11434
OLLAMA_AGENT_2_MODEL=qwen3:8b-q4_K_M
OLLAMA_AGENT_2_ROLE=builder
OLLAMA_AGENT_2_NUM_CTX=8192
OLLAMA_AGENT_2_NUM_PREDICT=768
OLLAMA_AGENT_2_THINK_LEVEL=medium
OLLAMA_AGENT_2_TEMPERAMENT="neugierig, praktisch und experimentierfreudig"
OLLAMA_AGENT_2_FOCUS="small reversible experiments and practical exploration"

# Add arbitrary further endpoints. Their numbers do not need to be consecutive.
# OLLAMA_AGENT_3_NAME=reviewer-1
# OLLAMA_AGENT_3_URL=http://10.10.10.42:11434
# OLLAMA_AGENT_3_MODEL=qwen3:8b-q4_K_M
# OLLAMA_AGENT_3_ROLE=steward
