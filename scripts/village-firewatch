#!/usr/bin/env python3
"""Run the read-only AI Village infrastructure guard."""
from pathlib import Path
import argparse
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from village.firewatch import run

parser = argparse.ArgumentParser()
parser.add_argument("--interval", type=float, default=30.0)
parser.add_argument("--output", type=Path, default=Path("/var/lib/ai-village/telemetry/firewatch.jsonl"))
args = parser.parse_args()
run(args.interval, args.output)
